# ===== 后端配置模板 =====
# 复制为 .env 后填写（.env 已被 .gitignore 排除，绝不要提交）

# --- 数据库 ---
# 本机 docker compose 起 PostgreSQL(pgvector)，默认端口 5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/companion

# --- LLM 接入（OpenAI 兼容协议）---
# M0 直连 DeepSeek 官方；后续可切 new-api 网关（只改 base_url，不动代码）
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# 仅本地开发兜底用；正常走 BYOK（前端设置页填，随 WS auth 帧传入，服务端不存）
LLM_API_KEY=

# --- 应用 ---
DEBUG=true
